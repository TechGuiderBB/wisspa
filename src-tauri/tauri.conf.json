{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisspa",
  "version": "0.1.0",
  "identifier": "com.techguider.wisspa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Wisspa",
        "width": 220,
        "height": 56,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "focus": false,
        "visible": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "overlay",
        "url": "index.html#overlay",
        "title": "Wisspa Recording",
        "width": 220,
        "height": 56,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "index.html#settings",
        "title": "Wisspa Settings",
        "width": 820,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "focus": true,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      },
      {
        "label": "onboarding",
        "url": "index.html#onboarding",
        "title": "Welcome to Wisspa",
        "width": 720,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "focus": true,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "System-wide AI voice tool",
    "longDescription": "Wisspa transcribes speech, executes voice commands, and rewrites rough intent into structured AI prompts.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMjJBNEUyQkQxNjE1RUEKUldUcUZSYTk0cVFpL2hDOFZSejduYzNyNWFRMTRKbCtrRU1kL2g2NW4xOHloTU1Zdmx2RHN1VzgK",
      "endpoints": [
        "https://github.com/TechGuiderau/wisspa/releases/latest/download/latest.json"
      ]
    }
  }
}
